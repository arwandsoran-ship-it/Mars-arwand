 // pin
 {const d=dirOf(THARSIS);let x1=d.x*Math.cos(yaw)+d.z*Math.sin(yaw),z1=-d.x*Math.sin(yaw)+d.z*Math.cos(yaw),y2=d.y*Math.cos(pitch)-z1*Math.sin(pitch),z2=d.y*Math.sin(pitch)+z1*Math.cos(pitch);
